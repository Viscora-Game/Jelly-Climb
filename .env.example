# MongoDB Connection String (Atlas or Local MongoDB)
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jelly_climb?retryWrites=true&w=majority
MONGODB_URI=

# Optional database name override (defaults to jelly_climb)
MONGODB_DB_NAME=jelly_climb

# Optional HTTP server port (defaults to 8123)
PORT=8123
